# این فایل رو کپی کن به .env.local و مقادیر واقعی رو بذار
# .env.local رو هیچ‌وقت commit نکن — باید تو .gitignore باشه

# ── Database (Postgres) ──
# Local: a local Postgres, or the Railway public URL for running migrations from your machine.
# On Railway: set to ${{Postgres.DATABASE_URL}} on the service (private network).
DATABASE_URL=postgresql://user:password@localhost:5432/aigraph

# ── AI gateway (AvalAI · gpt-4o per plan §3.0) — skill verification, week 7 ──
# Provider-agnostic: any OpenAI-compatible /chat/completions endpoint. The base
# URL is the ONLY place a provider is named — the gateway hardcodes nothing.
AI_BASE_URL=https://api.avalai.ir/v1
AI_API_KEY=your-key-here
AI_MODEL=gpt-4o

# ── GitHub (optional) ──
# Only public repos are read. Without a token the anonymous limit is 60 req/h and
# one verification costs ~5 requests — set this before a launch day of publishing.
GITHUB_TOKEN=
