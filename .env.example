# این فایل رو کپی کن به .env.local و مقادیر واقعی رو بذار
# .env.local رو هیچ‌وقت commit نکن — باید تو .gitignore باشه

# ── Database (Postgres) ──
# Local: a local Postgres, or the Railway public URL for running migrations from your machine.
# On Railway: set to ${{Postgres.DATABASE_URL}} on the service (private network).
DATABASE_URL=postgresql://user:password@localhost:5432/aigraph

# ── AI gateway (AvalAI · gpt-4o) — used from week 7 (skill verification) ──
AI_HA_API_KEY=your-key-here
AI_HA_BASE_URL=https://api.avalai.ir/v1
AI_HA_MODEL=gpt-4o
